rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ЗАМЕНИТЕ на e-mail администратора (тот, с которым входите в админ-панель).
    // Несколько админов: ['first@mail.com', 'second@mail.com']
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['admin@example.com'];
    }

    // Ароматы и отзывы: читать могут все, менять — только админ
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /reviews/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
